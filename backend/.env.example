# Copy to backend/.env and replace the password before starting Compose.
POSTGRES_USER=company_chat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=company_chat
# Compose supplies DATABASE_URL using the variables above. For direct Node use:
# DATABASE_URL=postgresql://company_chat:URL_ENCODED_PASSWORD@localhost:5432/company_chat
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
# Optional exact browser origins, comma separated. Empty disables CORS.
# Local Vite: CORS_ORIGINS=http://127.0.0.1:5173
# Production must use exact HTTPS origins; HTTP is rejected when NODE_ENV=production.
CORS_ORIGINS=
# Generate a unique random value; required even for development.
JWT_SECRET=replace-with-at-least-64-cryptographically-random-characters
JWT_ISSUER=company-chat-api
JWT_AUDIENCE=company-chat-clients
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT=10
GROUP_MEMBER_LIMIT=1000
WS_HEARTBEAT_INTERVAL_MS=30000
SESSION_CLEANUP_INTERVAL_MS=3600000
S3_ENDPOINT=http://storage:4566
S3_PUBLIC_ENDPOINT=http://127.0.0.1:4566
S3_REGION=us-east-1
S3_BUCKET=company-chat
S3_ACCESS_KEY=replace-with-localstack-access-key
S3_SECRET_KEY=replace-with-a-long-random-localstack-secret
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_TTL_SECONDS=300
S3_DOWNLOAD_TTL_SECONDS=60
ATTACHMENT_PENDING_TTL_MS=900000
ATTACHMENT_DAILY_QUOTA_BYTES=209715200
ATTACHMENT_RATE_LIMIT=20
# Supply bootstrap credentials only to the one-time bootstrap command.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

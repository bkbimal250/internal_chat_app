# Company Chat API — local environment template
#
# Copy this file, then replace every placeholder before starting Docker:
#   Copy-Item backend\.env.example backend\.env
#
# Never commit backend\.env

# --- Database ---
# Compose builds DATABASE_URL from these three values.
# For a direct Node process on the host, use an encoded URL instead:
# DATABASE_URL=postgresql://company_chat:URL_ENCODED_PASSWORD@127.0.0.1:5432/company_chat
POSTGRES_USER=company_chat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=company_chat

# --- Process ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Set TRUST_PROXY=1 only behind the production reverse proxy so rate limits see client IPs.
TRUST_PROXY=0

# --- Browser CORS ---
# Exact origins, comma-separated. Empty disables CORS.
# Bind Vite to 127.0.0.1 (not localhost) so SameSite cookies stay first-party.
# Production must use HTTPS origins; HTTP is rejected when NODE_ENV=production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Authentication ---
# JWT_SECRET must be at least 64 random characters, even in development.
JWT_SECRET=replace-with-at-least-64-cryptographically-random-characters
JWT_ISSUER=company-chat-api
JWT_AUDIENCE=company-chat-clients
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT=10

# --- OTP / Hilite SMS ---
# Required in production. Local development skips sending when these are empty.
OTP_RATE_LIMIT=8
OTP_TTL_SECONDS=60
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
SMS_API_URL=https://www.hilitemultimedia.co.in/websms/api/http/index.php
SMS_USERNAME=
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_SENDER=SPAADV
SMS_ROUTE=ServiceImplicit
# Keep the approved DLT wording. Change brand/template only after TRAI/DLT approval.
SMS_BRAND=Spa Advisor
# SMS_OTP_TEMPLATE=Dear Customer, your Code for login to {brand} is {code}. This Code is valid for {minutes} minutes. Do not share this OTP with anyone. Thank You

# --- Groups and realtime ---
GROUP_MEMBER_LIMIT=1000
WS_HEARTBEAT_INTERVAL_MS=30000
SESSION_CLEANUP_INTERVAL_MS=3600000

# Retention worker interval. Destructive 90-day cleanup stays off until an admin enables it.
RETENTION_WORKER_INTERVAL_MS=300000
RETENTION_WORKER_ENABLED=0

# --- Object storage ---
# Local LocalStack (below). For AWS S3, leave both endpoints blank, set
# S3_REGION to the bucket region, S3_FORCE_PATH_STYLE=false, S3_CREATE_BUCKET=false.
S3_ENDPOINT=http://storage:4566
S3_PUBLIC_ENDPOINT=http://127.0.0.1:4566
S3_REGION=us-east-1
S3_BUCKET=company-chat
S3_ACCESS_KEY=replace-with-localstack-access-key
S3_SECRET_KEY=replace-with-a-long-random-localstack-secret
S3_FORCE_PATH_STYLE=true

# LocalStack may create the bucket. Keep false for production AWS.
S3_CREATE_BUCKET=true
S3_UPLOAD_TTL_SECONDS=900
S3_DOWNLOAD_TTL_SECONDS=60
ATTACHMENT_PENDING_TTL_MS=7200000
ATTACHMENT_DAILY_QUOTA_BYTES=8589934592
ATTACHMENT_RATE_LIMIT=60

# Chat file attachments. Independent of text messaging.
# Production default is false when unset. Local/dev defaults on when unset.
CHAT_ATTACHMENTS_ENABLED=true

# Live audio calling. Call state is in-memory and is not written to Postgres or S3.
# Production default is false when unset. Do not put TURN_SECRET in clients.
CALLS_ENABLED=true
CALL_TIMEOUT_SECONDS=45
CALL_CONNECT_TIMEOUT_SECONDS=60
CALL_RATE_LIMIT=20
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Leave TURN empty until a dedicated coturn (or managed) service is approved.
TURN_URLS=
TURN_SECRET=
TURN_REALM=michat

# --- Firebase (optional) ---
# Leave the file missing to disable push. Do not commit the real JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# --- One-time admin bootstrap (do not leave set in the running API) ---
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

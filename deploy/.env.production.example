# Copy to /opt/company-chat/.env.production on the VPS (mode 600).
# Never commit the real file. This example is safe to commit.

COMPOSE_PROJECT_NAME=internal-chat
PROD_ENV_FILE=deploy/.env.production.example
# Local Compose validation uses :80. Production is the hostname only, e.g. chat.example.com
CHAT_SITE=:80
CADDY_EMAIL=admin@example.com

# Full image references, including the immutable sha-* tag from GitHub Actions.
API_IMAGE=ghcr.io/bkbimal250/internal_chat_app/api:sha-local-validate
WEB_IMAGE=ghcr.io/bkbimal250/internal_chat_app/web:sha-local-validate
IMAGE_TAG=sha-local-validate

# VPS-only GHCR pull credentials. Do not put these in GitHub Actions.
# GHCR_USERNAME=github
# GHCR_TOKEN=replace-with-read-packages-token

POSTGRES_USER=company_chat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=company_chat
# Compose builds DATABASE_URL from the three variables above. Override only if needed.
# DATABASE_URL=postgresql://company_chat:URL_ENCODED_PASSWORD@postgres:5432/company_chat

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=20000

# Same-origin web client can leave this empty.
# External S3/R2 browser uploads require the exact HTTPS site origin.
CORS_ORIGINS=

JWT_SECRET=replace-with-at-least-64-cryptographically-random-characters
JWT_ISSUER=company-chat-api
JWT_AUDIENCE=company-chat-clients
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT=10
OTP_RATE_LIMIT=8
OTP_TTL_SECONDS=60
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

SMS_API_URL=https://www.hilitemultimedia.co.in/websms/api/http/index.php
SMS_USERNAME=replace-with-sms-username
SMS_API_KEY=replace-with-sms-api-key
SMS_TEMPLATE_ID=replace-with-dlt-template-id
SMS_SENDER=SPAADV
SMS_ROUTE=ServiceImplicit

GROUP_MEMBER_LIMIT=1000
WS_HEARTBEAT_INTERVAL_MS=30000
SESSION_CLEANUP_INTERVAL_MS=3600000
RETENTION_WORKER_INTERVAL_MS=300000

# --- Object storage: pick one mode ---
# Recommended: AWS S3, Cloudflare R2, or external MinIO.
# STORAGE_IN_CLUSTER=0
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://media.example.com
# S3_FORCE_PATH_STYLE=true
# S3_CREATE_BUCKET=0
# CORS_ORIGINS=https://chat.example.com
#
# Existing LocalStack volume on this host (internal-chat_storage_data):
STORAGE_IN_CLUSTER=1
S3_ENDPOINT=http://storage:4566
S3_PUBLIC_ENDPOINT=https://chat.example.com/s3
S3_PROXY_UPSTREAM=storage:4566
S3_REGION=us-east-1
S3_BUCKET=company-chat
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-a-long-random-s3-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=1
S3_UPLOAD_TTL_SECONDS=900
S3_DOWNLOAD_TTL_SECONDS=60
ATTACHMENT_PENDING_TTL_MS=7200000
ATTACHMENT_DAILY_QUOTA_BYTES=8589934592
ATTACHMENT_RATE_LIMIT=60

FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
FIREBASE_SECRET_PATH=./deploy/secrets/firebase-unconfigured.json

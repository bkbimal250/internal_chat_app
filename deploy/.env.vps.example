# VPS template for /opt/company-chat/.env.production
# Copy keys into the existing production file. Never commit the real file.
#
#   # On the VPS, add or replace only the keys below. Keep JWT, SMS, S3, and
#   # database passwords that are already in .env.production.

COMPOSE_PROJECT_NAME=internal-chat
DEPLOY_TARGET=vps
COMPOSE_FILE=docker-compose.prod.vps.yml
PROD_ENV_FILE=deploy/.env.vps.example

# Loopback publish ports. Confirm they are free before first start:
#   ss -lntup | grep -E ':3045|:3046|:80|:443|:5432'
WEB_HOST_PORT=3046
API_HOST_PORT=3045

API_IMAGE=ghcr.io/bkbimal250/internal_chat_app/api:sha-local-validate
WEB_IMAGE=ghcr.io/bkbimal250/internal_chat_app/web:sha-local-validate
IMAGE_TAG=sha-local-validate

# Host PostgreSQL 16. Containers use host.docker.internal (Docker host-gateway).
# Backup/restore scripts on the VPS use 127.0.0.1, not the Docker gateway.
POSTGRES_USER=company_chat_user
POSTGRES_PASSWORD=replace-with-existing-vps-password
POSTGRES_DB=company_chat
POSTGRES_DUMP_HOST=127.0.0.1
POSTGRES_DUMP_PORT=5432
DATABASE_URL=postgresql://company_chat_user:URL_ENCODED_PASSWORD@host.docker.internal:5432/company_chat

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=20000

# Browser origin for the React app. Required because the API is a different host.
CORS_ORIGINS=https://web.michat.in

JWT_SECRET=replace-with-at-least-64-cryptographically-random-characters
JWT_ISSUER=company-chat-api
JWT_AUDIENCE=company-chat-clients
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT=10

OTP_RATE_LIMIT=8
OTP_TTL_SECONDS=60
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
SMS_API_URL=https://www.hilitemultimedia.co.in/websms/api/http/index.php
SMS_USERNAME=replace-with-sms-username
SMS_API_KEY=replace-with-sms-api-key
SMS_TEMPLATE_ID=replace-with-dlt-template-id
SMS_SENDER=SPAADV
SMS_ROUTE=ServiceImplicit
SMS_BRAND=Spa Advisor

GROUP_MEMBER_LIMIT=1000
WS_HEARTBEAT_INTERVAL_MS=30000
SESSION_CLEANUP_INTERVAL_MS=3600000
RETENTION_WORKER_INTERVAL_MS=300000
# Leave off until retention deletion safeguards are approved.
RETENTION_WORKER_ENABLED=0

# External object storage. Do not start LocalStack on this VPS.
# AWS S3: leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT blank so the SDK uses the
# regional endpoint. Set S3_FORCE_PATH_STYLE=false. Never set S3_CREATE_BUCKET=1.
# R2/MinIO: set both endpoints and S3_FORCE_PATH_STYLE=true.
STORAGE_IN_CLUSTER=0
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=michat-main-bucket
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-a-long-random-s3-secret
S3_FORCE_PATH_STYLE=false
S3_CREATE_BUCKET=0
S3_UPLOAD_TTL_SECONDS=900
S3_DOWNLOAD_TTL_SECONDS=60
ATTACHMENT_PENDING_TTL_MS=7200000
ATTACHMENT_DAILY_QUOTA_BYTES=8589934592
ATTACHMENT_RATE_LIMIT=60

# Keep both features off until the private bucket is approved and calling is ready.
# Unset also stays off in NODE_ENV=production. Do not set these true on this VPS yet.
CHAT_ATTACHMENTS_ENABLED=false
CALLS_ENABLED=false

FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
FIREBASE_SECRET_PATH=./secrets/firebase-service-account.json
